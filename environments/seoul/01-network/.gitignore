# --- Terraform 기본 ---
**/.terraform/*

# 상태 파일 (민감 정보 포함 가능)
*.tfstate
*.tfstate.*

# 크래시 로그
crash.log
crash.*.log

# 변수 파일 (보통 민감 정보 들어감)
*.tfvars
*.tfvars.json

# override 파일
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# 계획(plan) 파일
*.tfplan

# CLI 설정 파일
.terraformrc
terraform.rc

# (선택) 의존성 lock 파일
# 보통은 버전 고정을 위해 커밋하는 걸 권장하지만,
# 굳이 필요 없으면 아래 주석을 풀고 무시해도 됩니다.
#.terraform.lock.hcl
